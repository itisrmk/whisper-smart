# Maintainer: Rahul Kashyap <rahulmkashyap@gmail.com>
pkgname=whisper-smart
pkgver=0.5.0
pkgrel=1
pkgdesc="Hold-to-talk dictation for the Linux desktop"
arch=('x86_64' 'aarch64')
url="https://github.com/itisrmk/whisper-smart"
license=('MIT')
# gtk4-layer-shell is what puts the recording overlay above other windows on
# wlroots compositors; without it the overlay is skipped but dictation works.
depends=('gtk4' 'gtk4-layer-shell' 'alsa-lib' 'libpulse')
# wtype and wl-clipboard are the two text-insertion strategies; whisper.cpp is
# the default speech engine; uv provisions the Python the other engines need.
optdepends=(
    'wtype: type transcripts directly (recommended)'
    'wl-clipboard: clipboard paste fallback'
    'whisper-cpp: default local speech engine'
    'ggml-cpu: compute backend whisper-cpp needs to load a model'
    'ggml-cuda: CUDA acceleration for whisper-cpp on NVIDIA GPUs'
    'uv: provision the Python runtime for faster-whisper and Parakeet'
    'xdotool: text insertion on X11 sessions'
)
makedepends=('cargo' 'pkgconf')
source=()

build() {
    cd "$srcdir/../.."
    export RUSTUP_TOOLCHAIN=stable
    cargo build --release --frozen
}

check() {
    cd "$srcdir/../.."
    cargo test --release --frozen
}

package() {
    cd "$srcdir/../.."
    install -Dm755 "target/release/whisper-smart" "$pkgdir/usr/bin/whisper-smart"
    install -Dm644 "python/stt_daemon.py" "$pkgdir/usr/lib/whisper-smart/stt_daemon.py"
    install -Dm644 "packaging/whisper-smart.desktop" \
        "$pkgdir/usr/share/applications/whisper-smart.desktop"
    install -Dm644 "packaging/whisper-smart.service" \
        "$pkgdir/usr/lib/systemd/user/whisper-smart.service"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
